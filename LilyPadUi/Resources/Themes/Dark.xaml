<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- #Colors -->

    <Color x:Key="AcrylicBackgroundColor100">#2C2C2C</Color>

    <Color x:Key="WindowBackgroundColorPrimary100">#313338</Color>
    <Color x:Key="WindowBackgroundColorPrimary90">#36363D</Color>

    <Color x:Key="SolidControlColorPrimary170">#1A1B1E</Color>
    <Color x:Key="SolidControlColorPrimary160">#111214</Color>
    <Color x:Key="SolidControlColorPrimary150">#232428</Color>
    <Color x:Key="SolidControlColorPrimary140">#1E1E22</Color>
    <Color x:Key="SolidControlColorPrimary130">#2B2D31</Color>
    <Color x:Key="SolidControlColorPrimary125">#3B3D44</Color>
    <Color x:Key="SolidControlColorPrimary120">#404249</Color>
    <Color x:Key="SolidControlColorPrimary100">#4E5058</Color>
    <Color x:Key="SolidControlColorPrimary90">#6D6D76</Color>
    <Color x:Key="SolidControlColorPrimary80">#80848E</Color>
    <Color x:Key="SolidControlColorPrimaryDisabled">#494A50</Color>

    <Color x:Key="SolidControlColorSecondary100">#5865F2</Color>
    <Color x:Key="SolidControlColorSecondary110">#4752C4</Color>
    <Color x:Key="SolidControlColorSecondary120">#3C45A5</Color>
    <Color x:Key="SolidControlColorSecondaryDisabled">#424991</Color>

    <Color x:Key="SolidControlAccentColorPrimary100">#A3A4A7</Color>

    <Color x:Key="ControlAlertColorPrimary100">#DA373C</Color>
    <Color x:Key="ControlAlertColorPrimary110">#BC2F32</Color>
    <Color x:Key="ControlAlertColorPrimary120">#8F2022</Color>
    <Color x:Key="ControlAlertColorPrimaryDisabled">#DA373E</Color>

    <Color x:Key="ControlAlertColorSecondary100">#F0B132</Color>

    <Color x:Key="TextControlColorPrimary100">#383A40</Color>
    <Color x:Key="TextControlColorPrimary90">#BCBEC2</Color>

    <Color x:Key="TextColorPrimary100">#828790</Color>
    <Color x:Key="TextColorPrimary90">#B5BAC1</Color>
    <Color x:Key="TextColorPrimary80">#C1C3C7</Color>
    <Color x:Key="TextColorPrimaryDisabled">#66686C</Color>

    <Color x:Key="TextColorSecondary100">#FFFFFF</Color>
    <Color x:Key="TextColorSecondary110">#FDFEFE</Color>
    <Color x:Key="TextColorSecondary120">#E0E1E3</Color>
    <Color x:Key="TextColorSecondaryDisabled">#A3A4A7</Color>

    <Color x:Key="TextOnAccentColorPrimary100">#000000</Color>

    <Color x:Key="SurfaceStrokeColorFlyout">#33000000</Color>

    <!-- #Brushes -->

    <SolidColorBrush x:Key="ControlBackgroundFillColorBrush1" Color="{StaticResource SolidControlColorPrimary140}"/>
    <SolidColorBrush x:Key="ControlBackgroundFillColorBrush2" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ControlBackgroundFillColorBrush3" Color="{StaticResource SolidControlColorPrimary170}"/>

    <SolidColorBrush x:Key="LayerFillColorBrush1" Color="{StaticResource WindowBackgroundColorPrimary100}"/>
    <SolidColorBrush x:Key="LayerFillColorBrush2" Color="{StaticResource SolidControlColorPrimary130}"/>
    <SolidColorBrush x:Key="LayerFillColorBrush4" Color="{StaticResource SolidControlColorPrimary150}"/>
    <SolidColorBrush x:Key="LayerFillColorBrush5" Color="{StaticResource SolidControlColorPrimary160}"/>

    <SolidColorBrush x:Key="WindowBackgroundFillColorBrush" Color="{StaticResource WindowBackgroundColorPrimary90}"/>

    <SolidColorBrush x:Key="LayerAccentFillColorBrush1" Color="{StaticResource SolidControlColorSecondary100}"/>

    <SolidColorBrush x:Key="LayerWarningFillColorBrush1" Color="{StaticResource ControlAlertColorSecondary100}"/>

    <SolidColorBrush x:Key="TextColorBrush1" Color="{StaticResource TextColorPrimary80}"/>

    <SolidColorBrush x:Key="AccentTextColorBrush1" Color="{StaticResource TextColorSecondary110}"/>

    <SolidColorBrush x:Key="TextControlBackgroundColorBrush1" Color="{StaticResource TextControlColorPrimary100}"/>

    <SolidColorBrush x:Key="TextControlTextColorBrush1" Color="{StaticResource TextColorSecondary120}"/>


    <!-- #Elevation border brushes -->

    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent"/>

    <!-- #Controls -->
    
    <!-- #Button -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ButtonBackgroundMouseOver" Color="{StaticResource SolidControlColorPrimary90}"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource SolidControlColorPrimary80}"/>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource SolidControlColorPrimaryDisabled}"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource TextColorSecondaryDisabled}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="ButtonBorderBrushMouseOver" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource TextColorSecondaryDisabled}"/>

    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource SolidControlColorSecondary100}"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundMouseOver" Color="{StaticResource SolidControlColorSecondary110}"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource SolidControlColorSecondary120}"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{StaticResource SolidControlColorSecondaryDisabled}"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrushMouseOver" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="{StaticResource TextColorSecondaryDisabled}"/>

    <SolidColorBrush x:Key="DeleteButtonBackground" Color="{StaticResource ControlAlertColorPrimary100}"/>
    <SolidColorBrush x:Key="DeleteButtonBackgroundMouseOver" Color="{StaticResource ControlAlertColorPrimary110}"/>
    <SolidColorBrush x:Key="DeleteButtonBackgroundPressed" Color="{StaticResource ControlAlertColorPrimary120}"/>
    <SolidColorBrush x:Key="DeleteButtonBackgroundDisabled" Color="{StaticResource ControlAlertColorPrimaryDisabled}"/>
    <SolidColorBrush x:Key="DeleteButtonBorderBrushMouseOver" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="DeleteButtonBorderBrushPressed" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="DeleteButtonBorderBrushDisabled" Color="{StaticResource TextColorSecondaryDisabled}"/>

    <SolidColorBrush x:Key="EmptyDeleteButtonBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="EmptyDeleteButtonBackgroundMouseOver" Color="{StaticResource ControlAlertColorPrimary100}"/>
    <SolidColorBrush x:Key="EmptyDeleteButtonBackgroundPressed" Color="{StaticResource ControlAlertColorPrimary110}"/>
    <SolidColorBrush x:Key="EmptyDeleteButtonBackgroundDisabled" Color="{StaticResource ControlAlertColorPrimaryDisabled}"/>
    <SolidColorBrush x:Key="EmptyDeleteButtonBorderBrush" Color="{StaticResource ControlAlertColorPrimary100}"/>
    <SolidColorBrush x:Key="EmptyDeleteButtonBorderBrushMouseOver" Color="{StaticResource ControlAlertColorPrimary100}"/>
    <SolidColorBrush x:Key="EmptyDeleteButtonBorderBrushPressed" Color="{StaticResource ControlAlertColorPrimary110}"/>
    <SolidColorBrush x:Key="EmptyDeleteButtonBorderBrushDisabled" Color="{StaticResource ControlAlertColorPrimaryDisabled}"/>

    <SolidColorBrush x:Key="NavigationBarButtonBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationBarButtonBackgroundMouseOver" Color="{StaticResource WindowBackgroundColorPrimary90}"/>
    <SolidColorBrush x:Key="NavigationBarButtonBackgroundPressed" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="NavigationBarButtonBackgroundDisabled" Color="{StaticResource SolidControlColorPrimaryDisabled}"/>
    <SolidColorBrush x:Key="NavigationBarButtonBackgroundHighlighted" Color="{StaticResource SolidControlColorPrimary120}"/>
    <SolidColorBrush x:Key="NavigationBarButtonForeground" Color="{StaticResource TextColorPrimary80}"/>
    <SolidColorBrush x:Key="NavigationBarButtonForegroundMouseOver" Color="{StaticResource TextColorSecondary120}"/>
    <SolidColorBrush x:Key="NavigationBarButtonForegroundPressed" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="NavigationBarButtonForegroundDisabled" Color="{StaticResource TextColorSecondaryDisabled}"/>
    <SolidColorBrush x:Key="NavigationBarButtonForegroundHightlighted" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="NavigationBarButtonBorderBrush" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="NavigationBarButtonBorderBrushMouseOver" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="NavigationBarButtonBorderBrushPressed" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="NavigationBarButtonBorderBrushDisabled" Color="{StaticResource TextColorSecondaryDisabled}"/>


    <!-- #Calendar -->
    <SolidColorBrush x:Key="CalendarViewBackground" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="CalendarViewBackgroundSelected" Color="{StaticResource SolidControlColorPrimary80}"/>
    <SolidColorBrush x:Key="CalendarViewForeground" Color="{StaticResource TextColorPrimary100}"/>
    <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="{StaticResource SurfaceStrokeColorFlyout}"/>
    <SolidColorBrush x:Key="CalendarViewBorderBrushSelected" Color="{StaticResource SolidControlColorPrimary80}"/>
    <SolidColorBrush x:Key="CalendarViewTodayBackground" Color="{StaticResource SolidControlColorPrimary80}"/>
    <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="{StaticResource TextOnAccentColorPrimary100}"/>
    <SolidColorBrush x:Key="CalendarViewItemBackgroundMouseOver" Color="{StaticResource SolidControlColorPrimary90}"/>
    <SolidColorBrush x:Key="CalendarViewButtonForeground" Color="{StaticResource TextColorPrimary80}"/>


    <!-- #ComboBox -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TextColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBackground" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBackgroundEditable" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBackgroundMouseOver" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBackgroundPressed" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBackgroundDisabled" Color="{StaticResource SolidControlColorPrimaryDisabled}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBorderBrush" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBorderBrushEditable" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBorderBrushMouseOver" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBorderBrushPressed" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxToggleButtonBorderBrushDisabled" Color="{StaticResource SolidControlColorPrimaryDisabled}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource SolidControlColorPrimary130}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource SolidControlColorPrimary130}"/>
    <SolidColorBrush x:Key="ComboBoxEditableTextBoxForeground" Color="{StaticResource TextColorPrimary100}"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource SolidControlColorPrimary140}"/>
    
    
    <!-- #DatePicker -->
    <SolidColorBrush x:Key="DatePickerBackground" Color="{StaticResource SolidControlColorPrimary100}"/>
    <SolidColorBrush x:Key="DatePickerForeground" Color="{StaticResource TextColorPrimary100}"/>
        
        
    <!-- #Hyperlink -->
    <SolidColorBrush x:Key="HyperlinkForeground" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="HyperlinkForegroundDisabled" Color="{StaticResource TextColorSecondaryDisabled}"/>
        
        
    <!-- #Label -->
    <SolidColorBrush x:Key="LabelForeground" Color="{StaticResource TextColorPrimary100}"/>
    <SolidColorBrush x:Key="AccentLabelForeground" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="HeaderLabelForeground" Color="{StaticResource TextColorPrimary90}"/>
    
    
    <!-- #TextBlock -->
    <SolidColorBrush x:Key="TextBlockForeground" Color="{StaticResource TextColorPrimary90}"/>


    <!-- #TextBox -->
    <SolidColorBrush x:Key="TextBoxBackground" Color="{StaticResource TextControlColorPrimary100}"/>
    <SolidColorBrush x:Key="TextBoxBackgroundDisabled" Color="{StaticResource SolidControlColorPrimaryDisabled}"/>
    <SolidColorBrush x:Key="TextBoxForeground" Color="{StaticResource TextControlColorPrimary90}"/>
    <SolidColorBrush x:Key="TextBoxForegroundDisabled" Color="{StaticResource TextColorPrimaryDisabled}"/>
    <SolidColorBrush x:Key="TextBoxSelectionBrush" Color="{StaticResource SolidControlColorPrimary90}"/>
    <SolidColorBrush x:Key="TextBoxSelectionTextBrush" Color="{StaticResource TextColorSecondary100}"/>
    
    <!-- #ToolTip -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource SolidControlColorPrimary160}"/>
    <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource TextColorSecondary100}"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource SurfaceStrokeColorFlyout}"/>


    <!-- #Window -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColorPrimary100}"/>
    <SolidColorBrush x:Key="WindowForeground" Color="{StaticResource TextColorPrimary100}"/>

</ResourceDictionary>