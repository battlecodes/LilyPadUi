<Window x:Class="LilyPadTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LilyPadTest"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Style="{StaticResource DefaultWindowStyle}">
    <Window.Resources>
        <ResourceDictionary Source="/LilyPadUi;component/LilyPadUi.xaml"/>
    </Window.Resources>
    <Grid>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20">
            <Button Content="I'm a testy little button!"/>
        </StackPanel>
        
    </Grid>
</Window>
